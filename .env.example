NVIDIA_API_KEY=your_nvidia_key
DISCORD_WEBHOOK_URL=your_discord_webhook_url
DISCORD_BOT_TOKEN=your_discord_bot_token
# Comma-separated Discord user IDs allowed to chat with Bright Bot.
# Empty/missing = the bot answers NOBODY (fail-closed after the
# 2026-09-08 chat hardening). Find your ID: Discord settings ->
# Advanced -> Developer Mode, then right-click your name -> Copy ID.
DISCORD_OWNER_IDS=
TAVILY_API_KEY=your_tavily_key
